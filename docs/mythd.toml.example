# mythd daemon configuration. Copy to /etc/myth/mythd.toml (or point
# MYTHD_CONFIG at it) and edit. All keys are optional; defaults shown.

# Listen address. Defaults to 127.0.0.1 (loopback) — safe by default. Binding a
# NON-loopback address (e.g. 0.0.0.0) is refused unless api_keys is set (and TLS
# is strongly recommended): mythd fails closed rather than expose an
# unauthenticated endpoint to the network.
bind = "127.0.0.1:8443"

# GGUF model to serve. A BitNet i2_s (ternary) model takes the Arc fast path.
model_path = "/var/lib/myth/models/Qwen3-VL-30B-A3B-Instruct-Q4_K_M.gguf"
model_id   = "qwen3-vl-30b-a3b"

# Optional vision projector (mmproj GGUF). When set, the model accepts images
# (OpenAI vision format, inline data: URLs). Omit for a text-only model.
mmproj_path = "/var/lib/myth/models/mmproj-F16.gguf"

# Persistent ML-DSA-65 audit signing key (32-byte seed, created 0600 on first run,
# reused after). Keeping it persistent makes the audit log's verifying key stable
# across restarts — required for the tamper-evident chain to stay verifiable.
audit_key_path = "/etc/myth/keys/audit-mldsa65.seed"

# Persistent signed audit log. If set, every inference appends a signed,
# hash-chained entry (fsync'd), and the existing log is integrity-verified on
# startup (a tampered/corrupted log stops the daemon). Omit for in-memory only.
audit_log_path = "/var/lib/myth/audit.jsonl"

# Post-quantum TLS (requires building with `--features pq-tls`).
# Omit both to serve plain HTTP (the ML-KEM application-layer session still applies).
tls_cert = "/etc/myth/keys/cert.pem"
tls_key  = "/etc/myth/keys/key.pem"

# Bearer-token API keys. Clients authenticate with `Authorization: Bearer <key>`
# (standard OpenAI clients do this natively). If this list is empty/omitted,
# authentication is DISABLED and any reachable client may use the endpoints.
# /health is always open; everything else requires a valid key when set.
api_keys = ["sk-mythd-CHANGE-ME"]

# Limits.
max_sessions       = 256
default_max_tokens = 256

# Context window in tokens (KV cache). On a GQA model (few KV heads) the KV cache
# is small, so 16K-32K is cheap on a 32 GB card. Default 8192.
n_ctx = 32768

# KV cache precision: "f16" (default) or "q8_0" (INT8 — ~half the KV memory/
# bandwidth, a real long-context win; forces flash attention on).
kv_cache_type = "q8_0"
